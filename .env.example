# =============================================================================
# Alimzy International School Result Portal — environment template
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# --- Django -----------------------------------------------------------------
# Use ResultPortal.settings.dev locally and ResultPortal.settings.prod in prod.
DJANGO_SETTINGS_MODULE=ResultPortal.settings.dev
# Required. Use a long random value; never reuse the example placeholder.
SECRET_KEY=replace-with-a-long-random-secret
# Development only. Production forces DEBUG=False in prod settings.
DEBUG=True
# Comma-separated hostnames. Do not use "*" in production.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Lagos
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Preferred: a single URL. Examples:
#   postgres://resultportal:change-me@localhost:5432/resultportal
#   sqlite:///db.sqlite3            (local fallback only)
DATABASE_URL=postgres://resultportal:change-me@localhost:5432/resultportal
DB_CONN_MAX_AGE=600

# Legacy DB_* variables (optional; only used when DATABASE_URL is empty).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Docker Compose (local Postgres) ---------------------------------------
POSTGRES_DB=resultportal
POSTGRES_USER=resultportal
# Required by docker compose; choose a local-only password.
POSTGRES_PASSWORD=change-me
# Image tag used by docker-compose.prod.yml.
WEB_IMAGE=resultportal:latest

# --- CORS / CSRF ------------------------------------------------------------
# Frontend origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origins trusted for Django CSRF checks (admin/session flows).
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- API throttling ---------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=1000/day
THROTTLE_LOGIN=5/min
THROTTLE_REFRESH=30/min
API_PAGE_SIZE=20
PASSWORD_MIN_LENGTH=8

# --- Email ------------------------------------------------------------------
# Development uses the console backend (emails are printed to the terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@alimzy.example

# --- Production transport security -----------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Optional monitoring (Batch 6) -----------------------------------------
SENTRY_DSN=
